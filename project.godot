; Engine configuration file.
; Godot 4.7 (.NET build). Edit through the editor or by hand.

config_version=5

[application]

config/name="LootFall"
config/description="Shake sealed chests, read the clues, strike a deal with each customer, and crack them open."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="LootFall"

[gui]

theme/custom_font="res://assets/fonts/kenney_mini.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.082, 0.067, 0.114, 1)
